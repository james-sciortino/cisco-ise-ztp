# Local environment data belongs in these directories, regardless of extension.
/local/
/secrets/
/backups/
/artifacts/
/reports/
/logs/
/media/
/config/
/configs/
.env
.env.*
*.local.*
*.secret.*
*credentials*
*.pem
*.key
*.p12
*.pfx
